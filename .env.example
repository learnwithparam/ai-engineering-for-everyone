# Copy this file to .env and fill in ONE key. .env is git-ignored. Never paste a key into a chat or a commit.
# replay (the default) needs no key. Then: anthropic, openrouter, openai or ollama.
LLM_PROVIDER=replay
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
# Only for LLM_PROVIDER=ollama
OLLAMA_BASE_URL=
OLLAMA_MODEL=
